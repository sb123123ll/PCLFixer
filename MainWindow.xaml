<Window x:Class="PCLFixer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCL2 原版MC下载限制一键修复工具" Height="540" Width="720"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#F5F6F8" FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2B579A" CornerRadius="8" Padding="18,14" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="PCL2 启动器原版MC下载一键修复工具" FontSize="19" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <Button x:Name="BtnHelp" Content="使用说明 / 常见问题" HorizontalAlignment="Right" Click="BtnHelp_Click" 
                            Padding="10,4" Background="#3D6CB0" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </DockPanel>
                <TextBlock Text="一键解除“为遵守相关法律法规，PCL暂时不再提供MC下载功能”限制，恢复原版下载与版本列表" 
                           FontSize="12" Foreground="#D0E1F9" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Usage Guide Card -->
        <Border Grid.Row="1" Background="#EBF3FB" CornerRadius="8" Padding="14,10" Margin="0,0,0,12" BorderBrush="#B8D7F7" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="💡 极简使用说明：" FontWeight="Bold" Foreground="#1E4E8C" FontSize="13" Margin="0,0,0,4"/>
                <TextBlock Text="① 工具已自动为你检索并填好电脑里的 PCL2 路径（若路径不对，点【浏览...】手动选你的 Plain Craft Launcher 2.exe 即可）。" 
                           FontSize="12" Foreground="#2A5C98" TextWrapping="Wrap"/>
                <TextBlock Text="② 点击绿色的【立即开始修复】按钮，等待 1~3 秒提示成功即可。" 
                           FontSize="12" Foreground="#2A5C98" TextWrapping="Wrap" Margin="0,2,0,0"/>
                <TextBlock Text="③ 重新打开 PCL2 启动器，进入【下载】页面即可畅玩下载原版 Minecraft！" 
                           FontSize="12" Foreground="#2A5C98" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Target Path Selection -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="目标 PCL2 启动器路径 (可自动扫描或手动选择)：" FontSize="13" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,6"/>

                <ComboBox Grid.Row="1" Grid.Column="0" x:Name="ComboPaths" IsEditable="True" Height="34" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                <Button Grid.Row="1" Grid.Column="1" x:Name="BtnBrowse" Content="浏览..." Width="80" Height="34" Margin="0,0,8,0" Click="BtnBrowse_Click" Cursor="Hand" Background="#E8ECEF" BorderBrush="#CED4DA"/>
                <Button Grid.Row="1" Grid.Column="2" x:Name="BtnScan" Content="自动扫描" Width="90" Height="34" Click="BtnScan_Click" Cursor="Hand" Background="#E8ECEF" BorderBrush="#CED4DA"/>
            </Grid>
        </Border>

        <!-- Action Button & Status -->
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ProgressBar Grid.Column="0" x:Name="ProgressBarStatus" Height="38" Margin="0,0,14,0" Minimum="0" Maximum="100" Value="0" Foreground="#28A745" Background="#E9ECEF"/>
            <Button Grid.Column="1" x:Name="BtnStartFix" Content="立即开始修复" Width="190" Height="40" FontSize="15" FontWeight="Bold" Foreground="White" Background="#28A745" BorderThickness="0" Click="BtnStartFix_Click" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Log Output -->
        <Border Grid.Row="4" Background="#1E1E1E" CornerRadius="8" Padding="10" BorderBrush="#333" BorderThickness="1">
            <ScrollViewer x:Name="ScrollerLog" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="TxtLog" Background="Transparent" Foreground="#D4D4D4" BorderThickness="0" 
                         FontFamily="Consolas, Courier New" FontSize="12" IsReadOnly="True" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="5" Margin="0,10,0,0">
            <TextBlock Text="提示：修复工具支持自动备份、结束正在运行的冲突进程、解锁系统保护属性，请放心使用。" 
                       FontSize="11" Foreground="#666" VerticalAlignment="Center"/>
            <Button Content="打开所在目录" HorizontalAlignment="Right" Click="BtnOpenDir_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="#0066CC"/>
        </DockPanel>
    </Grid>
</Window>
